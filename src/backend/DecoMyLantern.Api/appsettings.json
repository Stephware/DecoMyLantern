{
  "ConnectionStrings": {
    "DefaultConnection": ";Max Pool Size=100;Min Pool Size=5;Connection Lifetime=300"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/bemyparol-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithProperty:Application=BeMyParol" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RateLimits": {
    "OwnerCreate": { "PermitLimit": 6, "WindowHours": 1 },
    "InvitationCreate": { "PermitLimit": 120, "WindowHours": 1 },
    "InvitationPreview": { "PermitLimit": 120, "WindowMinutes": 1 },
    "InvitationContribute": { "PermitLimit": 80, "WindowMinutes": 15 },
    "DesignShowcase": { "PermitLimit": 36, "WindowMinutes": 10 },
    "ParolImageOwner": { "PermitLimit": 60, "WindowMinutes": 10 },
    "ParolImageGuest": { "PermitLimit": 60, "WindowMinutes": 10 },
    "StoryOwner": { "PermitLimit": 10, "WindowHours": 1 },
    "StoryVideoStatus": { "PermitLimit": 100, "WindowMinutes": 1 },
    "StoryVideoDownload": { "PermitLimit": 30, "WindowHours": 1 },
    "StoryGuest": { "PermitLimit": 12, "WindowHours": 1 },
    "OwnerRecoveryDisplay": { "PermitLimit": 18, "WindowHours": 1 },
    "OwnerRecoveryReplace": { "PermitLimit": 3, "WindowHours": 1 },
    "GuestVisitorCreate": { "PermitLimit": 20, "WindowHours": 1 },
    "OwnerRecover": { "PermitLimit": 3, "WindowMinutes": 15 }
  }
}
