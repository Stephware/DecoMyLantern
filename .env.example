# Copy this file to .env and set your SQL Server connection details.
# host.docker.internal reaches a SQL Server running on the Docker host.
DATABASE_CONNECTION_STRING=Server=host.docker.internal,1433;Database=DecoMyLanternDb;User Id=YOUR_USER;Password=YOUR_PASSWORD;Encrypt=True;TrustServerCertificate=True;
FRONTEND_PORT=5173
BACKEND_PORT=5050
# Create a remotely managed Cloudflare Tunnel and set its token here.
CLOUDFLARED_TOKEN=
