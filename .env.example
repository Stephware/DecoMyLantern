# Copy this file to .env and set your SQL Server connection details.
# host.docker.internal reaches a SQL Server running on the Docker host.
DATABASE_CONNECTION_STRING=Server=host.docker.internal,1433;Database=DecoMyLanternDb;User Id=YOUR_USER;Password=YOUR_PASSWORD;Encrypt=True;TrustServerCertificate=True;
FRONTEND_PORT=5173
BACKEND_PORT=5050
# Set false and rebuild the frontend to disable banners, AdSense, and popunders.
ADS_ENABLED=true
# Generate once with: openssl rand -base64 32
# Keep this value unchanged across deployments or existing links cannot be decoded.
INVITATION_ENCRYPTION_KEY=
# Generate once with: openssl rand -hex 32
# Internal-only authorization for the Remotion renderer.
STORY_RENDERER_SECRET=
# Create a remotely managed Cloudflare Tunnel and set its token here.
CLOUDFLARED_TOKEN=
